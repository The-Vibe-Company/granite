# Required by Granite. Set your own value in the deployment environment.
TYPESAFE_API_KEY=<your-typesafe-api-key>
# Required for personal Railway MCP deployments; keep it separate from the UI password.
GRANITE_MCP_TOKEN=<strong-random-mcp-token>
# Optional hosted read-only dashboard. UNSET by default: all /ui routes return 404.
# To enable, replace the placeholder with a unique password-manager-generated value
# of at least 16 non-padding characters. Never commit a filled-in env file.
# GRANITE_UI_PASSWORD=<strong-unique-dashboard-password>
